# T1 红线：凭证只从环境变量读，禁止把真实密钥写进本文件或任何代码/配置/日志。
# 复制为 .env（已 gitignore）后填真实值。命名口径：env_prefix=APP_，嵌套用 __（见 config/settings.py）。

# ── 运行环境（E2：dev/staging/prod 只差 config，代码零分支）───────────────
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_ARTIFACT_DIR=workspace
APP_AUDIT_DIR=workspace/audit

# ── 装配表 ProviderChoices（逐端口定档，ADR-005/v0.7.1）─────────────────
# M0 默认值=零依赖可跑通档（dev_hash/dev_lexical/dev_echo/memory/filesystem/pg_queue/plain）。
# 执行档目标档：embedding=local、rerank=local、llm=cloud、vectorstore=milvus、objectstore=filesystem。
# 取消注释即换档（G5：换档只改这里，业务代码零改动）：
# APP_PROVIDERS__EMBEDDING=local
# APP_PROVIDERS__RERANK=local
# APP_PROVIDERS__LLM=cloud
# APP_PROVIDERS__VECTORSTORE=milvus
# APP_PROVIDERS__OBJECTSTORE=s3
# APP_PROVIDERS__MQ=kafka
# APP_PROVIDERS__ORCHESTRATION=langgraph

# ── 本地模型锚（ADR-004；embedding/rerank 执行档主档）───────────────────
APP_LOCAL_EMBEDDING_MODEL=qwen3-embedding-0.6b
APP_LOCAL_EMBEDDING_MODEL_DIR=
APP_LOCAL_RERANK_MODEL=bge-reranker-v2-m3
# NFR-8 fail-loud：batch 安全上界=物理显存×0.9 反推，越界必须告警
APP_LOCAL_BATCH_SAFE=32
APP_VRAM_SAFETY_FACTOR=0.9

# ── 云侧（仅当对应端口切到 cloud 时必填；否则装配 fail-fast）────────────
APP_CLOUD_LLM_BASE_URL=
APP_CLOUD_LLM_API_KEY=
APP_CLOUD_EMBEDDING_BASE_URL=
APP_CLOUD_EMBEDDING_API_KEY=

# ── 生产数据源（M1+ 接入时填；M0 用内存/文件系统档）──────────────────────
APP_PG_DSN=
APP_MILVUS_URI=
# 对象库/队列企业档连接（仅当 APP_PROVIDERS__OBJECTSTORE=s3 / __MQ=kafka 时必填；缺值装配 fail-loud，绝不静默回落默认档）
# 凭证走 boto3 默认 env 链（AWS_ACCESS_KEY_ID 等），本处不写字面密钥（T1）。
APP_S3_BUCKET=
APP_S3_ENDPOINT_URL=
APP_KAFKA_BROKER=

# ── 目录批量入库（M4-ce 1b：POST /api/ingest/dir 与 CLI `ingest` 的允许根目录）──────
# 缺省空＝该入口整档不可用（501/退出码 1），绝不"指哪读哪"；给出后请求目录仍须落在该根内（越界 403）。
# 读盘范围＝此单一目录树（本地目录档，非真实源连接器；自动抓取＝放行项㉒、增量调度＝放行项②）。
APP_INGEST_SOURCE_DIR=

# ── 出网白名单（T5/§10 高危口径；M4 前置② 供给装配表声明项）────────────────
# 执行档唯一常态出网点=受控 LLM 网关（一问一答）；真密级语料不出机（本地装配域）。
# 应用侧装配预检（fail-fast）：非空时，选定云档的 base_url 主机必须在此集内，否则启动即拒（M4-al）。
# 网络层真·防火墙强制仍属部署侧放行项⑥；逗号分隔，空=不启用预检（dev 档）。
APP_EGRESS_ALLOWLIST_HOSTS=
# 例（云档启用时）：APP_EGRESS_ALLOWLIST_HOSTS=gw.internal-llm.example.com,objects.example.com

