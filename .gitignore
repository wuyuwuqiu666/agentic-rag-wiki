# ===== Python 缓存 / 虚拟环境 =====
__pycache__/
*.py[cod]
*.pyo
*.pyd
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.json
.venv/
venv/
env/
*.egg-info/
.eggs/

# ===== Node 前端（node_modules 85MB，绝不入库）=====
node_modules/
*.local
.vite/

# ===== 凭证（T1 红线：字面密钥永不入库）=====
.env
.env.*
!.env.example
.git-credentials
*.pem
*.key

# ===== 运行时中间产物（可再生，C1）=====
workspace/*
!workspace/.gitkeep
workspace-run/
.tmp/
temp/
*.log

# ===== OS / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
